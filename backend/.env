# Backend environment variables (local, DO NOT COMMIT)
# IMPORTANT: Do NOT commit real credentials. Copy values from .env.example or set them in your deployment platform.
# Database connection (Neon DB pooler) - set this in your hosting provider's environment variables (e.g., Vercel, Render).
DATABASE_URL=postgresql://neondb_owner:npg_PAzsW7twcy9Y@ep-morning-cloud-ahuxkfoj-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# JWT secret (change to a strong random value in production)
JWT_SECRET=replace-with-a-strong-secret
# Server port
PORT=3001
# NODE_ENV can be development or production
NODE_ENV=development
#
# Optional: Supabase configuration (set these if you're using Supabase alongside Neon)
# SUPABASE_URL: Public URL of your Supabase project
# SUPABASE_SERVICE_ROLE_KEY: Service role key (KEEP THIS SECRET — server-side only)
# SUPABASE_ANON_KEY: Public anon key (used by frontend clients)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Admin credentials for single-user deployments (only for local/dev; prefer env vars in platform)
# ADMIN_USERNAME: username for initial admin user (default: admin)
# ADMIN_PASSWORD: initial admin password (server-side only; keep secret)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123.
