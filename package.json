{
  "name": "horeca-quotation-tool",
  "version": "1.0.0",
  "description": "Quotation Generator Web Application for HORECA",
  "private": true,
  "scripts": {
    "install:all": "npm install",
    "install:frontend": "cd frontend && npm install",
    "setup:fonts": "node backend/setup-fonts.js",
    "setup": "npm run install:all && npm run setup:fonts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "node backend/server.js",
    "seed": "node backend/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pdfmake": "^0.2.10",
    "sql.js": "^1.10.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.3"
  }
}

